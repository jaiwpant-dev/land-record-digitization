# Optional stricter upload limit for the Flask OCR API. Values above the
# existing 20 MiB ingestion limit are ignored.
# LAND_RECORD_MAX_UPLOAD_BYTES=20971520

# Required for FastAPI record persistence. Set real values in local `.env` or
# the deployment platform's secret/environment settings; never commit them.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Comma-separated production frontend origins. Do not use `*` in production.
LAND_RECORD_API_CORS_ORIGINS=https://your-frontend.example
